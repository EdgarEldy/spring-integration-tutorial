# Copy to .env (ignored by git) and adjust. Read by docker-compose.yml only.
DB_NAME=spring_integration_tutorial
DB_USER=spring_integration_tutorial
# The dev profile (application-dev.yml) falls back to the same defaults: if you change a value here,
# export it too before running the application outside Docker.
DB_PASSWORD=spring_integration_tutorial
# Host ports: 5433 avoids a PostgreSQL already installed locally on 5432.
DB_PORT=5433
APP_PORT=8080
# Profile of the application container: dev brings the demo data and the integration graph.
SPRING_PROFILES_ACTIVE=dev
# User and group the application container runs as. They should own the mounted order directories
# on the host (on Linux, "id -u" and "id -g"), so the application can move and write files there.
APP_UID=1000
APP_GID=1000
# Signing secret of the JWTs issued on login, at least 32 bytes. Same default as application-dev.yml:
# replace it on any machine other than your own.
APP_JWT_SECRET=dev-only-jwt-secret-change-me-at-least-32-bytes
# Optional ADMIN account (the only role allowed to approve or reject an order), created at startup
# when both values are set. There is no default password: uncomment and choose your own.
# APP_ADMIN_EMAIL=admin@example.com
# APP_ADMIN_PASSWORD=
